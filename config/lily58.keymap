#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        clear_terminal: clear_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp L &kp E &kp A &kp R &kp ENTER &kp ENTER>;
            label = "CLEAR_TERMINAL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&mt ESC EQUAL       &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                                          &kp N6       &kp N7    &kp N8     &kp N9   &kp N0              &kp GRAVE
&kp CAPS            &kp Q   &kp W   &kp E     &kp R     &kp T                                                           &kp Y        &kp U     &kp I      &kp O    &kp P               &kp MINUS
&mt LEFT_SHIFT TAB  &kp A   &kp S   &kp D     &kp F     &kp G                                                           &kp H        &kp J     &kp K      &kp L    &kp SEMI            &mt RIGHT_SHIFT SQT
&kp LEFT_WIN        &kp Z   &kp X   &kp C     &kp V     &kp B        &kp LBKT                &kp RBKT                   &kp N        &kp M     &kp COMMA  &kp DOT  &mt RIGHT_ALT FSLH  &mt RCTRL DEL
                                    &kp LALT  &kp LGUI  &lt 1 ENTER  &mt LEFT_CONTROL TAB    &mt RIGHT_SHIFT BACKSPACE  &lt 2 SPACE  &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp ESC          &kp F1           &kp F2            &kp F3             &kp F4                &kp F5                                   &kp F6        &kp F7        &kp F8        &kp F9      &kp F10       &kp F11
&kp GRAVE        &kp EXCLAMATION  &kp AT_SIGN       &kp HASH           &kp DOLLAR            &kp PERCENT                              &kp N7        &kp N8        &kp N9        &kp MINUS   &kp SLASH     &kp F12
&kp GRAVE        &kp CARET        &kp AMPERSAND     &kp STAR           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS    &kp ASTERISK  &kp BACKSPACE
&clear_terminal  &trans           &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans    &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL     &kp ENTER
                                                    &trans             &trans                &trans                 &trans    &trans  &kp N0        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans         &trans             &trans         &trans   &trans  &trans
&trans  &trans  &kp N2  &kp N3  &kp N4  &trans                    &kp PAGE_UP    &kp HOME           &kp UP_ARROW   &kp END  &trans  &trans
&trans  &kp F2  &kp F3  &kp F4  &kp F5  &trans                    &kp PAGE_DOWN  &kp LEFT           &kp DOWN       &kp UP   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans         &kp LS(LC(MINUS))  &kp LC(EQUAL)  &trans   &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans         &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
